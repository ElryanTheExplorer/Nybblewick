; Engine configuration file.
; Godot 4.7. Edit through the editor where possible.

config_version=5

[application]

config/name="Nybblewick"
config/description="Hand-sign nybble spellcasting prototype."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ChordInput="*res://scripts/input/chord_input.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

anti_aliasing/quality/msaa_3d=0
